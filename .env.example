# Personal access token. Do not paste the short-lived registration token from the
# "New self-hosted runner" page. See GUIDE.md.
#
# Organization runner, classic token: admin:org (the parent scope, not only
# "Self-hosted runners"). The GitHub account must be an organization owner.
# Fine-grained token: organization Administration, Read and write.
ACCESS_TOKEN=

# Number of runner containers. gen-compose.cmd / gen-compose.sh reads this.
RUNNER_COUNT=4

# Runner names become ${RUNNER_NAME_PREFIX}-1, ${RUNNER_NAME_PREFIX}-2, ...
RUNNER_NAME_PREFIX=runner

LABELS=docker

# Organization runner. ORG_NAME is the URL slug, not a full GitHub URL.
RUNNER_SCOPE=org
ORG_NAME=your-org

# Repository runner. Comment the two organization lines above, then set:
# RUNNER_SCOPE=repo
# REPO_URL=https://github.com/OWNER/REPO
